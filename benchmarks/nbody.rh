// The n-body simulation of the Computer Language Benchmarks Game.

type Body = { x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, m: Float }

fn pi() -> Float = 3.141592653589793
fn days() -> Float = 365.24
fn solar() -> Float = 4.0 * pi() * pi()

fn body(x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, m: Float) -> Body =
  Body { x, y, z, vx: vx * days(), vy: vy * days(), vz: vz * days(), m: m * solar() }

fn system() -> Array[Body] = [
  Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, m: solar() },
  body(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01,
       1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05, 9.54791938424326609e-04),
  body(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01,
       -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04),
  body(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01,
       2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05, 4.36624404335156298e-05),
  body(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01,
       2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05, 5.15138902046611451e-05),
]

fn offset(bs: Array[Body]) -> Array[Body] = {
  let p = bs.fold((0.0, 0.0, 0.0), fn(acc, b) => {
    let (px, py, pz) = acc
    (px + b.vx * b.m, py + b.vy * b.m, pz + b.vz * b.m)
  })
  let (px, py, pz) = p
  let sun = bs[0]
  bs.set(0, Body { vx: -px / solar(), vy: -py / solar(), vz: -pz / solar(), ..sun })
}

fn energy(bs: Array[Body], i: Int, e: Float) -> Float =
  if i >= bs.len() { e }
  else {
    let b = bs[i]
    let e = e + 0.5 * b.m * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
    energy(bs, i + 1, pairs(bs, b, i + 1, e))
  }

fn pairs(bs: Array[Body], b: Body, j: Int, e: Float) -> Float =
  if j >= bs.len() { e }
  else {
    let c = bs[j]
    let dx = b.x - c.x
    let dy = b.y - c.y
    let dz = b.z - c.z
    pairs(bs, b, j + 1, e - b.m * c.m / Float.sqrt(dx * dx + dy * dy + dz * dz))
  }

// Updates the velocities of bodies i and j.
fn interact(bs: Array[Body], i: Int, j: Int, dt: Float) -> Array[Body] =
  if j >= bs.len() { bs }
  else {
    let b = bs[i]
    let c = bs[j]
    let dx = b.x - c.x
    let dy = b.y - c.y
    let dz = b.z - c.z
    let d2 = dx * dx + dy * dy + dz * dz
    let mag = dt / (d2 * Float.sqrt(d2))
    let bs = bs.set(i, Body { vx: b.vx - dx * c.m * mag, vy: b.vy - dy * c.m * mag, vz: b.vz - dz * c.m * mag, ..b })
    let bs = bs.set(j, Body { vx: c.vx + dx * b.m * mag, vy: c.vy + dy * b.m * mag, vz: c.vz + dz * b.m * mag, ..c })
    interact(bs, i, j + 1, dt)
  }

fn velocities(bs: Array[Body], i: Int, dt: Float) -> Array[Body] =
  if i >= bs.len() { bs } else { velocities(interact(bs, i, i + 1, dt), i + 1, dt) }

fn positions(bs: Array[Body], i: Int, dt: Float) -> Array[Body] =
  if i >= bs.len() { bs }
  else {
    let b = bs[i]
    positions(bs.set(i, Body { x: b.x + dt * b.vx, y: b.y + dt * b.vy, z: b.z + dt * b.vz, ..b }), i + 1, dt)
  }

fn advance(bs: Array[Body], n: Int) -> Array[Body] =
  if n == 0 { bs } else { advance(positions(velocities(bs, 0, 0.01), 0, 0.01), n - 1) }

fn main() {
  let bs = offset(system())
  println(energy(bs, 0, 0.0).format(9))
  let bs = advance(bs, 50_000_000)
  println(energy(bs, 0, 0.0).format(9))
}
